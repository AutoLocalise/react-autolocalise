{
  "type": "module",
  "name": "react-autolocalise",
  "version": "1.2.0",
  "description": "Auto-translation SDK for React and Next.js applications with SSR support",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.cjs",
      "types": "./dist/server/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c && cp dist/server/server/index.d.ts dist/server/index.d.ts && rm -rf dist/server/server",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "react",
    "next",
    "nextjs",
    "ssr",
    "translation",
    "i18n",
    "localization"
  ],
  "author": "AutoLocalise",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.5",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AutoLocalise/react-autolocalise"
  },
  "bugs": {
    "url": "https://github.com/AutoLocalise/react-autolocalise/issues"
  },
  "homepage": "https://www.autolocalise.com"
}
